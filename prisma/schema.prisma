generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, unaccent]
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH  (unchanged)
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Role hierarchy: owner > admin > moderation_admin > reviewer > source_verifier > verified_contributor > contributor > user | banned
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActiveAt  DateTime?

  // Trust & activity
  trustScore      Float   @default(50)
  activityScore   Float   @default(0)
  rank            String  @default("New Seeker")

  // Moderation state
  isBanned        Boolean  @default(false)
  banReason       String?  @db.Text
  banExpiresAt    DateTime?
  warningCount    Int      @default(0)

  // Submission counters (denormalized for performance)
  submissionCount Int      @default(0)
  approvedCount   Int      @default(0)
  rejectedCount   Int      @default(0)

  accounts              Account[]
  sessions              Session[]
  progress              UserProgress?
  permissions           UserPermission?
  trustEvents           UserTrustEvent[]
  activityLogs          UserActivityLog[]
  earnedBadges          UserBadge[]
  submitted             Source[]               @relation("SubmittedSources")
  reviewed              Source[]               @relation("ReviewedSources")
  submittedNodes        ProposedNode[]         @relation("SubmittedNodes")
  reviewedNodes         ProposedNode[]         @relation("ReviewedNodes")
  submittedEdges        ProposedEdge[]         @relation("SubmittedEdges")
  reviewedEdges         ProposedEdge[]         @relation("ReviewedEdges")
  nodeExplorations      NodeExploration[]
  connectionDiscoveries ConnectionDiscovery[]
  achievements          UserAchievement[]
  aiReviews             AiResearchReview[]     @relation("AiReviewCreator")
  reportsSubmitted      Report[]               @relation("ReportSubmitter")
  reportsAgainst        Report[]               @relation("ReportedUser")
  modActions            ModerationAction[]     @relation("ModeratedUser")
  modByMe               ModerationAction[]     @relation("ModeratorUser")
  riskProfile           UserRiskProfile?
  activityEvents        UserActivityEvent[]
  moderationStatus      UserModerationStatus?

  // Phase D — Private Beta
  betaGroup         String?
  betaFeedback      BetaFeedback[]
  inviteRedemptions BetaInviteRedemption[]
  usageEvents       UsageEvent[]

  @@index([role])
  @@index([trustScore])
  @@index([isBanned])
  @@index([lastActiveAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER PROGRESS
// ─────────────────────────────────────────────────────────────────────────────

model UserProgress {
  id                    String   @id @default(cuid())
  userId                String   @unique
  xp                    Int      @default(0)
  level                 String   @default("Curious Visitor")
  // Legacy array columns — kept for Zustand sync, superseded by junction tables
  theoriesExplored      String[] @default([])
  connectionsDiscovered String[] @default([])
  achievements          String[] @default([])
  rabbitHoleChain       String[] @default([])
  rabbitHoleDepth       Int      @default(0)
  recentDiscoveries     String[] @default([])
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Junction tables replacing the unbounded String[] columns above
model NodeExploration {
  userId     String
  nodeId     String
  exploredAt DateTime @default(now())
  xpAwarded  Int      @default(30)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([userId])
  @@index([nodeId])
  @@index([exploredAt])
}

model ConnectionDiscovery {
  userId       String
  fromNodeId   String
  toNodeId     String
  discoveredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, fromNodeId, toNodeId])
  @@index([userId])
  @@index([discoveredAt])
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  xpAwarded     Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TAXONOMY
// ─────────────────────────────────────────────────────────────────────────────

model Galaxy {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?    @db.Text
  icon        String?    // lucide-react icon name
  color       String?    // hex accent
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categories  Category[]

  @@index([slug])
  @@index([order])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique // 'ancient-civilizations'
  name        String              // 'Ancient Civilizations'
  description String?    @db.Text
  color       String?
  parentId    String?
  galaxyId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  galaxy      Galaxy?    @relation(fields: [galaxyId], references: [id], onDelete: SetNull)
  nodes       Node[]

  @@index([parentId])
  @@index([galaxyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// KNOWLEDGE GRAPH  (graduated from static TypeScript files to DB)
// ─────────────────────────────────────────────────────────────────────────────

model Node {
  id              String   @id // human-readable slug: 'gobekli-tepe'
  title           String
  categoryId      String
  description     String   @db.Text
  mainstreamView  String?  @db.Text
  evidenceLevel   String   @default("speculative")
  confidenceScore Float    @default(0.5)
  color           String?
  icon            String?

  // Geography
  lat             Float?
  lon             Float?
  region          String?
  country         String?

  // Temporal
  year            Int?
  dateStart       Int?
  dateEnd         Int?
  datePrecision   String?

  // Lifecycle
  status          String   @default("draft") // draft | published | archived
  version         Int      @default(1)
  publishedAt     DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Import tracking
  importBatchId   String?
  importBatch     ImportBatch? @relation("BatchNodes", fields: [importBatchId], references: [id], onDelete: SetNull)

  // Admin review
  adminReviewStatus String?  // ready_to_review | review_required | needs_enrichment | soft_rejected
  adminReviewNote   String?  @db.Text

  // Relations
  category        Category       @relation(fields: [categoryId], references: [id])
  tags            NodeTag[]
  claims          Claim[]
  criticisms      Criticism[]
  openQuestions   OpenQuestion[]
  sourceLinks       SourceLink[]
  edgesFrom         Edge[]                   @relation("EdgeFrom")
  edgesTo           Edge[]                   @relation("EdgeTo")
  versions          NodeVersion[]
  embedding         NodeEmbedding?
  adjacencyCache    AdjacencyCache?
  narrative         NodeNarrative?
  suggestionsFrom   RelationshipSuggestion[] @relation("SuggestionFrom")
  suggestionsTo     RelationshipSuggestion[] @relation("SuggestionTo")
  aiReviews         AiResearchReview[]       @relation("NodeAiReviews")

  @@index([categoryId])
  @@index([status])
  @@index([evidenceLevel])
  @@index([confidenceScore])
  @@index([lat, lon])
  @@index([year])
  @@index([dateStart, dateEnd])
  @@index([createdAt])
  @@index([importBatchId])
  // Raw SQL adds:
  //   GIN index on search_vector (tsvector column added via migration)
  //   GIN index on title using gin_trgm_ops
}

model NodeTag {
  nodeId String
  tag    String
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([nodeId, tag])
  @@index([tag])
}

model Edge {
  id               String   @id @default(cuid())
  fromId           String
  toId             String
  relationshipType String   // 'historical' | 'geographical' | 'textual' | 'thematic' | 'influence' | 'contradictory'
  strengthScore    Float    @default(0.5)
  confidenceScore  Float    @default(0.5)
  explanation      String   @db.Text
  evidenceBasis    String   @db.Text
  sourceType       String   // SourceType enum string
  sourceCount      Int?
  status           String   @default("draft") // draft | published
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Import tracking
  importBatchId    String?
  importBatch      ImportBatch? @relation("BatchEdges", fields: [importBatchId], references: [id], onDelete: SetNull)

  from        Node         @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          Node         @relation("EdgeTo",   fields: [toId],   references: [id], onDelete: Cascade)
  sourceLinks SourceLink[]

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
  @@index([relationshipType])
  @@index([confidenceScore])
  @@index([status])
  @@index([importBatchId])
}

// Claims as first-class rows — stable IDs allow reliable source linking
model Claim {
  id          String       @id @default(cuid())
  nodeId      String
  text        String       @db.Text
  orderIndex  Int          @default(0)
  node        Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  sourceLinks SourceLink[]

  @@index([nodeId])
}

model Criticism {
  id          String       @id @default(cuid())
  nodeId      String
  text        String       @db.Text
  orderIndex  Int          @default(0)
  node        Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  sourceLinks SourceLink[]

  @@index([nodeId])
}

model OpenQuestion {
  id         String @id @default(cuid())
  nodeId     String
  text       String @db.Text
  orderIndex Int    @default(0)
  node       Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
}

// Full snapshot of node state at each version — enables rollback and diff
model NodeVersion {
  id         String   @id @default(cuid())
  nodeId     String
  version    Int
  snapshot   Json     // complete node state at this version
  changedBy  String?
  changeNote String?
  createdAt  DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, version])
  @@index([nodeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// VECTOR EMBEDDINGS  (stored separately; raw SQL accesses via pgvector)
// ─────────────────────────────────────────────────────────────────────────────

model NodeEmbedding {
  nodeId    String   @id
  // Actual column type is vector(1536) — set via raw SQL migration.
  // We declare as Float[] here so Prisma client can write values;
  // reads requiring ANN search use $queryRaw with ::vector cast.
  embedding Float[]
  model     String   @default("text-embedding-3-small")
  updatedAt DateTime @updatedAt

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model SourceEmbedding {
  sourceId  String   @id
  embedding Float[]
  model     String   @default("text-embedding-3-small")
  updatedAt DateTime @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// ADJACENCY CACHE  (materialized 1- and 2-hop neighborhoods for hot nodes)
// ─────────────────────────────────────────────────────────────────────────────

model AdjacencyCache {
  nodeId   String   @id
  hop1     Json     // { nodeId, edgeId, score, direction }[]
  hop2     Json     // { nodeId, viaNodeId, score }[]
  cachedAt DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// INGESTION JOB QUEUE  (pg-boss replacement for simple workloads)
// ─────────────────────────────────────────────────────────────────────────────

model IngestionJob {
  id          String    @id @default(cuid())
  type        String    // 'embed-node' | 'embed-source' | 'rebuild-adjacency'
  targetId    String
  priority    Int       @default(50) // 0–100; higher = runs first
  status      String    @default("pending") // pending | processing | done | failed
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, priority(sort: Desc)])
  @@index([type, status])
  @@index([targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SOURCE INGESTION SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

model Source {
  id              String   @id @default(cuid())
  title           String
  sourceType      String
  author          String?
  publicationYear Int?
  publisher       String?
  journal         String?
  volume          String?
  issue           String?
  pages           String?
  url             String?
  doi             String?  @unique
  isbn            String?
  abstract        String?  @db.Text
  notes           String?  @db.Text
  // Why the submitter believes this source is credible — required for AI review context
  sourceTrustExplanation String? @db.Text
  language        String   @default("en")

  credibilityScore   Float @default(0.5)
  credibilityFactors Json?

  // Admin can override the auto-computed score; overriddenBy is a User.id
  credibilityOverride Float?
  overriddenBy        String?
  overrideReason      String? @db.Text

  status      String    @default("pending")
  reviewNotes String?   @db.Text
  reviewedAt  DateTime?

  submittedBy String?
  reviewedBy  String?
  submitter   User?   @relation("SubmittedSources", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewer    User?   @relation("ReviewedSources",  fields: [reviewedBy],  references: [id], onDelete: SetNull)

  // Import tracking
  importBatchId String?
  importBatch   ImportBatch? @relation("BatchSources", fields: [importBatchId], references: [id], onDelete: SetNull)

  links     SourceLink[]
  embedding SourceEmbedding?

  // Source Intelligence Engine (Phase C)
  analysis                 SourceAnalysis?
  potentialNodeSuggestions PotentialNodeSuggestion[]
  contradictionSuggestions ContradictionSuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sourceType])
  @@index([submittedBy])
  @@index([createdAt])
  @@index([credibilityScore])
  @@index([importBatchId])
}

// Updated SourceLink: supports both legacy string-target pattern and new FK pattern.
// New code uses nodeId / edgeId / claimId / criticismId FKs.
// Legacy code (seed, old API) uses targetType / targetId / claimIndex.
model SourceLink {
  id          String @id @default(cuid())
  sourceId    String

  // Legacy columns — kept for backward compat with seed script and old API routes
  targetType  String? // 'node' | 'claim' | 'edge'
  targetId    String?
  claimIndex  Int?

  // New FK columns — use these in new code
  nodeId      String?
  edgeId      String?
  claimId     String?
  criticismId String?

  linkType      String  @default("supports") // supports | contradicts | context | primary | references
  relevanceScore Float  @default(0.5)       // 0–1: how relevant is this source to this specific target
  notes         String?
  createdAt     DateTime @default(now())

  source      Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  node        Node?      @relation(fields: [nodeId],      references: [id], onDelete: Cascade)
  edge        Edge?      @relation(fields: [edgeId],      references: [id], onDelete: Cascade)
  claim       Claim?     @relation(fields: [claimId],     references: [id], onDelete: Cascade)
  criticism   Criticism? @relation(fields: [criticismId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([nodeId])
  @@index([edgeId])
  @@index([claimId])
  @@index([targetType, targetId])
  // Legacy unique — still needed for seed script upserts
  @@unique([sourceId, targetType, targetId, claimIndex], name: "legacy_source_link_unique")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY PROPOSALS  (unchanged — review workflow stays the same)
// ─────────────────────────────────────────────────────────────────────────────

model ProposedNode {
  id             String   @id @default(cuid())
  nodeId         String?
  label          String
  category       String
  description    String   @db.Text
  evidenceLevel  String   @default("speculative")
  confidence     Float    @default(0.5)
  claims         Json?
  criticisms     Json?
  openQuestions  Json?
  mainstreamView String?  @db.Text
  region         String?
  country        String?
  dateStart      Int?
  dateEnd        Int?
  tags           Json?

  status      String    @default("pending")
  reviewNotes String?   @db.Text
  reviewedAt  DateTime?
  submittedBy String?
  reviewedBy  String?
  submitter   User?     @relation("SubmittedNodes", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewer    User?     @relation("ReviewedNodes",  fields: [reviewedBy],  references: [id], onDelete: SetNull)

  // AI quality audit (Claude Haiku, fire-and-forget on submission)
  aiAuditResult     Json?
  aiAuditedAt       DateTime?

  // Similarity against existing archive nodes (fire-and-forget on submission)
  proposalSimilarity Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([submittedBy])
  @@index([category])
}

model ProposedEdge {
  id              String   @id @default(cuid())
  fromNodeId      String
  toNodeId        String
  relationship    String
  description     String   @db.Text
  evidenceLevel   String   @default("speculative")
  confidence      Float    @default(0.5)
  strengthScore   Float    @default(0.5)
  explanation     String?  @db.Text
  historicalBasis String?  @db.Text

  status      String    @default("pending")
  reviewNotes String?   @db.Text
  reviewedAt  DateTime?
  submittedBy String?
  reviewedBy  String?
  submitter   User?     @relation("SubmittedEdges", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewer    User?     @relation("ReviewedEdges",  fields: [reviewedBy],  references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([submittedBy])
}

// ─────────────────────────────────────────────────────────────────────────────
// IMPORT BATCH  (tracks bulk JSON imports; enables rollback and audit)
// ─────────────────────────────────────────────────────────────────────────────

model ImportBatch {
  id               String    @id @default(cuid())
  importedBy       String?   // user ID of the admin who ran the import
  inputFormat      String    @default("json")
  parsedCount      Int       @default(0)
  acceptedCount    Int       @default(0)
  rejectedCount    Int       @default(0)
  warningCount     Int       @default(0)
  validationReport Json      // full per-record validation detail
  status           String    @default("committed") // committed | rolledback
  rolledBackAt     DateTime?
  rolledBackBy     String?
  createdAt        DateTime  @default(now())

  nodes   Node[]   @relation("BatchNodes")
  edges   Edge[]   @relation("BatchEdges")
  sources Source[] @relation("BatchSources")

  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI RABBIT-HOLE NARRATIVES  (cached per-node exploration context)
// ─────────────────────────────────────────────────────────────────────────────

model NodeNarrative {
  nodeId        String   @id
  narrative     String   @db.Text
  model         String
  promptVersion String   @default("1.0")
  cachedAt      DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG  (immutable record of admin actions)
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// RELATIONSHIP SUGGESTIONS  (rule-based graph intelligence, human review gate)
// ─────────────────────────────────────────────────────────────────────────────

model RelationshipSuggestion {
  id               String    @id @default(cuid())
  fromNodeId       String
  toNodeId         String

  // Requirement #10: connection classification
  relationshipType String    // contradiction | source_relationship | geographical | historical | thematic | textual | speculative

  // Requirement #9: every connection needs these
  reason           String    @db.Text
  evidenceBasis    String    @db.Text
  confidenceScore  Float     @default(0.5)
  riskLevel        String    @default("medium")  // low | medium | high

  // Signal breakdown for transparency and future weight adjustment
  signalBreakdown  Json      @default("{}")

  // Requirement #5: reviewer decision tracking
  status           String    @default("pending")  // pending | approved | rejected | revised
  reviewedBy       String?
  reviewerEmail    String?
  reviewedAt       DateTime?
  reviewNote       String?   @db.Text
  promotedEdgeId   String?

  // Generation metadata
  triggeredByNodeId String?
  generationMethod  String   @default("rule_based")

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  fromNode Node @relation("SuggestionFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   Node @relation("SuggestionTo",   fields: [toNodeId],   references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId])
  @@index([status])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([confidenceScore])
  @@index([triggeredByNodeId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  action     String   // publish | unpublish | archive | restore | edit | approve | reject | needs_revision | import | rollback | bulk_approve | bulk_reject | bulk_publish
  entityType String   // node | edge | batch
  entityId   String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model AiResearchReview {
  id            String   @id @default(cuid())
  nodeId        String
  model         String
  promptVersion String
  reviewJson    Json
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  estimatedCost Float    @default(0)
  createdAt     DateTime @default(now())
  createdBy     String?

  node    Node  @relation("NodeAiReviews",  fields: [nodeId],    references: [id], onDelete: Cascade)
  creator User? @relation("AiReviewCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([nodeId])
  @@index([createdAt])
  @@index([createdBy])
}

// ─────────────────────────────────────────────────────────────────────────────
// GOVERNANCE — PERMISSIONS, TRUST, ACTIVITY, BADGES, MODERATION
// ─────────────────────────────────────────────────────────────────────────────

model UserPermission {
  userId                  String   @id
  canApproveSources       Boolean  @default(false)
  canApproveRelationships Boolean  @default(false)
  canApproveNodes         Boolean  @default(false)
  canPublishNodes         Boolean  @default(false)
  canAssignRoles          Boolean  @default(false)
  canBanUsers             Boolean  @default(false)
  canRunAiReview          Boolean  @default(false)
  canViewPlatformHealth   Boolean  @default(false)
  canViewTraffic          Boolean  @default(false)
  canViewCosts            Boolean  @default(false)
  canViewSecurityLogs     Boolean  @default(false)
  updatedAt               DateTime @updatedAt
  updatedBy               String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserTrustEvent {
  id        String   @id @default(cuid())
  userId    String
  delta     Float
  reason    String
  detail    String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UserActivityLog {
  id         String   @id @default(cuid())
  userId     String
  actionType String
  detail     Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
}

model Badge {
  id          String @id
  name        String
  description String
  icon        String
  category    String

  holders UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  awardedBy String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Report {
  id             String    @id @default(cuid())
  submittedBy    String
  reportedUserId String?
  entityType     String
  entityId       String
  reason         String
  detail         String?   @db.Text
  status         String    @default("open")
  resolvedBy     String?
  resolvedAt     DateTime?
  resolveNote    String?   @db.Text
  createdAt      DateTime  @default(now())

  submitter    User  @relation("ReportSubmitter", fields: [submittedBy],    references: [id], onDelete: Cascade)
  reportedUser User? @relation("ReportedUser",    fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedBy])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ModerationAction {
  id          String    @id @default(cuid())
  userId      String
  moderatorId String
  actionType  String
  reason      String    @db.Text
  detail      Json?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user      User @relation("ModeratedUser", fields: [userId],      references: [id], onDelete: Cascade)
  moderator User @relation("ModeratorUser", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moderatorId])
  @@index([actionType])
  @@index([createdAt])
}

model PlatformMetric {
  id          String   @id @default(cuid())
  date        DateTime
  metricName  String
  metricValue Float
  metricMeta  Json?

  @@unique([date, metricName])
  @@index([date])
  @@index([metricName])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER RISK & ACTIVITY INTELLIGENCE
// ─────────────────────────────────────────────────────────────────────────────

model UserRiskProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  riskScore        Float    @default(0)
  riskLevel        String   @default("low")
  spamScore        Float    @default(0)
  botScore         Float    @default(0)
  lastCalculatedAt DateTime @default(now())
  reasons          Json     @default("[]")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([riskScore])
  @@index([riskLevel])
  @@index([lastCalculatedAt])
}

model UserActivityEvent {
  id            String   @id @default(cuid())
  userId        String
  eventType     String
  path          String?
  metadata      Json     @default("{}")
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@index([eventType, createdAt])
}

model UserModerationStatus {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    String   @default("active")
  reason    String?
  changedBy String?
  changedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([changedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// RESEARCH SIMILARITY  (advisory metadata — never creates graph edges)
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// SYSTEM CONFIG  (key-value store for runtime settings)
// ─────────────────────────────────────────────────────────────────────────────

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─────────────────────────────────────────────────────────────────────────────
// ARCHIVE AUDIT  (AI-powered archive quality audit runs and findings)
// ─────────────────────────────────────────────────────────────────────────────

model ArchiveAuditRun {
  id          String                @id @default(cuid())
  status      String                @default("running")
  triggeredBy String
  startedAt   DateTime              @default(now())
  completedAt DateTime?
  summary     Json                  @default("{}")
  settings    Json                  @default("{}")
  findings    ArchiveAuditFinding[]

  @@index([status])
  @@index([startedAt(sort: Desc)])
}

model ArchiveAuditFinding {
  id          String          @id @default(cuid())
  runId       String
  type        String
  severity    String
  status      String          @default("pending")
  nodeId      String?
  edgeId      String?
  title       String
  description String          @db.Text
  beforeState Json            @default("{}")
  afterState  Json            @default("{}")
  reasoning   String          @db.Text
  autoFixable Boolean         @default(false)
  webSources  Json            @default("[]")
  reviewedBy  String?
  reviewedAt  DateTime?
  appliedAt   DateTime?
  applyError  String?         @db.Text
  run         ArchiveAuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([type, severity])
  @@index([nodeId])
}

model ResearchSimilarity {
  id      String @id @default(cuid())
  nodeAId String
  nodeBId String

  overallSimilarity      Float @default(0)
  thematicSimilarity     Float @default(0)
  timelineSimilarity     Float @default(0)
  geographicSimilarity   Float @default(0)
  sourceSimilarity       Float @default(0)
  evidenceSimilarity     Float @default(0)
  entitySimilarity       Float @default(0)
  relationshipSimilarity Float @default(0)

  researchPotentialScore Float @default(0)
  confidence             Float @default(0)

  explanation    String @default("") @db.Text
  criticAnalysis Json   @default("[]")
  breakdown      Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nodeAId, nodeBId])
  @@index([nodeAId])
  @@index([nodeBId])
  @@index([overallSimilarity(sort: Desc)])
  @@index([researchPotentialScore(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// SOURCE INTELLIGENCE ENGINE  (Phase C)
// Every approved source runs through the pipeline and produces advisory
// extractions only. AI may extract/suggest — never publish or auto-approve.
// ─────────────────────────────────────────────────────────────────────────────

model SourceAnalysis {
  id              String  @id @default(cuid())
  sourceId        String  @unique
  status          String  @default("pending") // pending | processing | complete | failed
  pipelineVersion String  @default("1.0")

  aiSummary       String? @db.Text
  relationshipHints Json  @default("[]") // [{fromNodeId, toNodeId, reason, confidence, relType}]

  entityCount      Int @default(0)
  claimCount       Int @default(0)
  timelineCount    Int @default(0)
  locationCount    Int @default(0)
  nodeCount        Int @default(0)
  contradictionCount Int @default(0)

  processingError  String?  @db.Text
  startedAt        DateTime?
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source         Source                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  entities       ExtractedEntity[]
  claims         ExtractedClaim[]
  timelineRefs   TimelineReference[]
  locationRefs   LocationReference[]
  potentialNodes PotentialNodeSuggestion[]
  contradictions ContradictionSuggestion[]

  @@index([status])
  @@index([createdAt])
}

model ExtractedEntity {
  id            String @id @default(cuid())
  analysisId    String
  entityType    String // person | organization | location | event | artifact | concept | text
  name          String
  aliases       String[]
  context       String @db.Text
  confidence    Float  @default(0.5)
  matchedNodeId String?

  createdAt DateTime       @default(now())
  analysis  SourceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([entityType])
  @@index([matchedNodeId])
}

model ExtractedClaim {
  id            String  @id @default(cuid())
  analysisId    String
  claimText     String  @db.Text
  claimType     String  // factual | temporal | geographic | causal | speculative | contradictory
  confidence    Float   @default(0.5)
  supportedBy   String? @db.Text
  relatedNodeId String?
  status        String  @default("pending") // pending | reviewed | applied | dismissed

  createdAt DateTime       @default(now())
  analysis  SourceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([relatedNodeId])
  @@index([status])
}

model TimelineReference {
  id            String  @id @default(cuid())
  analysisId    String
  year          Int?
  yearStart     Int?
  yearEnd       Int?
  datePrecision String? // exact | decade | century | millennium | era
  description   String  @db.Text
  period        String?
  confidence    Float   @default(0.5)
  rawText       String  @db.Text
  relatedNodeId String?

  createdAt DateTime       @default(now())
  analysis  SourceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([year])
}

model LocationReference {
  id            String  @id @default(cuid())
  analysisId    String
  name          String
  locationType  String  // country | region | city | site | ancient_name
  modernName    String?
  lat           Float?
  lon           Float?
  confidence    Float   @default(0.5)
  context       String  @db.Text
  relatedNodeId String?

  createdAt DateTime       @default(now())
  analysis  SourceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([locationType])
}

model PotentialNodeSuggestion {
  id           String @id @default(cuid())
  analysisId   String
  sourceId     String

  suggestedTitle         String
  suggestedCategory      String
  suggestedDescription   String @db.Text
  suggestedEvidenceLevel String @default("speculative")
  suggestedConfidence    Float  @default(0.3)
  suggestedTags          String[]
  suggestedYear          Int?
  suggestedLocation      String?
  reasoning              String @db.Text
  aiConfidence           Float  @default(0.5)

  status        String    @default("pending") // pending | approved | dismissed | applied
  reviewedBy    String?
  reviewedAt    DateTime?
  appliedNodeId String?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  analysis  SourceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  source    Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([sourceId])
  @@index([status])
}

model ContradictionSuggestion {
  id           String @id @default(cuid())
  analysisId   String
  sourceId     String

  existingNodeId    String
  contradictionType String // evidence_conflict | factual_dispute | dating_conflict | geographic_conflict | authorship_conflict
  description       String @db.Text
  sourceClaimText   String @db.Text
  nodeClaimText     String @db.Text
  severity          String @default("moderate") // minor | moderate | significant
  aiConfidence      Float  @default(0.5)

  status     String    @default("pending") // pending | reviewed | applied | dismissed
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  analysis  SourceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  source    Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([existingNodeId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// PRIVATE BETA PROGRAM  (Phase D)
// ─────────────────────────────────────────────────────────────────────────────

model BetaFeedback {
  id            String    @id @default(cuid())
  userId        String?
  category      String    // bug | usability | credibility | discovery | content | other
  severity      String    // low | medium | high | critical
  page          String    // current view/page when feedback was submitted
  description   String    @db.Text
  screenshotUrl String?
  reproSteps    String?   @db.Text
  status        String    @default("open")   // open | reviewing | resolved | dismissed
  adminNotes    String?   @db.Text
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([createdAt])
  @@index([userId])
}

model BetaInvite {
  id        String    @id @default(cuid())
  code      String    @unique
  email     String?
  group     String    // researcher | archaeologist | historian | ufo_researcher | skeptic | journalist | student | curious
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdBy String
  notes     String?
  createdAt DateTime  @default(now())

  redemptions BetaInviteRedemption[]

  @@index([code])
  @@index([group])
  @@index([createdAt])
}

model BetaInviteRedemption {
  id         String   @id @default(cuid())
  inviteId   String
  userId     String
  redeemedAt DateTime @default(now())

  invite BetaInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@index([inviteId])
  @@index([userId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  eventType String   // search | search_click | graph_view | timeline_view | globe_view | source_view | node_submit | rabbit_hole | node_view | evidence_view | universe_view
  meta      Json?
  page      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@index([sessionId])
}
