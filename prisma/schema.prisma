generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  progress         UserProgress?
  submitted        Source[]         @relation("SubmittedSources")
  reviewed         Source[]         @relation("ReviewedSources")
  submittedNodes   ProposedNode[]   @relation("SubmittedNodes")
  reviewedNodes    ProposedNode[]   @relation("ReviewedNodes")
  submittedEdges   ProposedEdge[]   @relation("SubmittedEdges")
  reviewedEdges    ProposedEdge[]   @relation("ReviewedEdges")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProgress {
  id                    String   @id @default(cuid())
  userId                String   @unique
  xp                    Int      @default(0)
  level                 String   @default("Curious Visitor")
  theoriesExplored      String[] @default([])
  connectionsDiscovered String[] @default([])
  achievements          String[] @default([])
  rabbitHoleChain       String[] @default([])
  rabbitHoleDepth       Int      @default(0)
  recentDiscoveries     String[] @default([])
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// SOURCE INGESTION SYSTEM
// ─────────────────────────────────────────────

model Source {
  id              String   @id @default(cuid())
  title           String
  sourceType      String   // 'Academic Paper' | 'Historical Text' | 'Archaeological Report' | 'Government Document' | 'Book' | 'News Investigation' | 'Religious Text' | 'Museum Archive' | 'Folklore Collection'
  author          String?
  publicationYear Int?
  publisher       String?
  journal         String?  // for Academic Paper
  volume          String?
  issue           String?
  pages           String?
  url             String?
  doi             String?  @unique
  isbn            String?
  abstract        String?  @db.Text
  notes           String?  @db.Text
  language        String   @default("en")

  // Credibility
  credibilityScore   Float  @default(0.5)
  credibilityFactors Json?  // { factor: number }

  // Workflow status
  status      String   @default("pending") // 'pending' | 'approved' | 'rejected' | 'needs_revision'
  reviewNotes String?  @db.Text
  reviewedAt  DateTime?

  // Relations
  submittedBy String?
  reviewedBy  String?
  submitter   User?   @relation("SubmittedSources", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewer    User?   @relation("ReviewedSources", fields: [reviewedBy], references: [id], onDelete: SetNull)

  links       SourceLink[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([sourceType])
  @@index([submittedBy])
  @@index([createdAt])
}

model SourceLink {
  id         String  @id @default(cuid())
  sourceId   String
  targetType String  // 'node' | 'claim' | 'edge'
  targetId   String  // graph node id or edge id
  claimIndex Int?    // if targetType == 'claim': 0-based index into node.claims[]
  linkType   String  @default("supports") // 'supports' | 'contradicts' | 'references'
  notes      String?

  source     Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([sourceId, targetType, targetId, claimIndex])
  @@index([sourceId])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────
// ADMIN RESEARCH DASHBOARD — PROPOSALS
// ─────────────────────────────────────────────

model ProposedNode {
  id             String   @id @default(cuid())
  nodeId         String?  // desired graph id (slug); auto-generated on approval if blank
  label          String
  category       String   // NodeCategory
  description    String   @db.Text
  evidenceLevel  String   @default("speculative")
  confidence     Float    @default(0.5)
  claims         Json?    // string[]
  criticisms     Json?    // string[]
  openQuestions  Json?    // string[]
  mainstreamView String?  @db.Text
  region         String?
  country        String?
  dateStart      Int?
  dateEnd        Int?
  tags           Json?    // string[]

  status      String   @default("pending") // pending | approved | rejected | needs_revision
  reviewNotes String?  @db.Text
  reviewedAt  DateTime?
  submittedBy String?
  reviewedBy  String?
  submitter   User?    @relation("SubmittedNodes", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewer    User?    @relation("ReviewedNodes", fields: [reviewedBy], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([submittedBy])
  @@index([category])
}

model ProposedEdge {
  id              String   @id @default(cuid())
  fromNodeId      String   // id of source node (static or proposed)
  toNodeId        String   // id of target node
  relationship    String   // RelationshipType
  description     String   @db.Text
  evidenceLevel   String   @default("speculative")
  confidence      Float    @default(0.5)
  strengthScore   Float    @default(0.5)
  explanation     String?  @db.Text
  historicalBasis String?  @db.Text

  status      String   @default("pending")
  reviewNotes String?  @db.Text
  reviewedAt  DateTime?
  submittedBy String?
  reviewedBy  String?
  submitter   User?    @relation("SubmittedEdges", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewer    User?    @relation("ReviewedEdges", fields: [reviewedBy], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([submittedBy])
}
